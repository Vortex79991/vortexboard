(async () => {
  try { await DB.open(); } catch (e) { DB.mem = new Map(); toast('Хранилище недоступно — изменения не сохранятся'); }
  const saved = await DB.get('tree');
  if (saved && saved.nodes) tree = saved;
  else {
    const f = { id: uid(), type: 'folder', name: 'Мой проект', parent: null, open: true, created: Date.now() };
    const b = { id: uid(), type: 'board', name: 'Доска 1', parent: f.id, open: true, created: Date.now() + 1 };
    tree = { nodes: { [f.id]: f, [b.id]: b }, current: b.id };
    await saveTree();
  }
  resize();
  const id = tree.current && tree.nodes[tree.current] ? tree.current : (Object.values(tree.nodes).find(n => n.type === 'board') || {}).id;
  if (id) await openBoard(id); else { renderTree(); closeBoard(); }
  setTimeout(() => gcAssets().catch(() => {}), 4000); // drop photos left over from deleted objects
})();
</script>
