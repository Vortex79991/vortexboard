let tree = { nodes: {}, current: null };
let cur = null;               // { id, objects, view:{x,y,z} }
let undoStack = [], redoStack = [];
let selectedId = null;        // selected image id
let targetFolder = null;      // where new items are created
let drawing = null;           // active stroke
let drag = null;              // active pointer interaction
let spaceDown = false;
let cursorPos = null;
let sprayTimer = null;
