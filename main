// first output of mulberry32 for a per-point seed: stable jitter for pencil strokes, no allocations
function hash01(seed, i, k) {
  const s = (seed + i * 7919 + k * 104729 + 0x6D2B79F5) | 0;
  let t = Math.imul(s ^ s >>> 15, 1 | s);
  t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
  return ((t ^ t >>> 14) >>> 0) / 4294967296;
}

let toastT;
function toast(msg) {
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2200);
}

/* =========================================================
   Storage (IndexedDB, memory fallback)
   ========================================================= */
const DB = {
  db: null, mem: null,
  open() {
    return new Promise((res, rej) => {
      const r = indexedDB.open('inkboard', 1);
      r.onupgradeneeded = () => r.result.createObjectStore('kv');
      r.onsuccess = () => { this.db = r.result; res(); };
      r.onerror = () => rej(r.error);
    });
  },
  req(mode, fn) {
    return new Promise((res, rej) => {
      const r = fn(this.db.transaction('kv', mode).objectStore('kv'));
      r.onsuccess = () => res(r.result); r.onerror = () => rej(r.error);
    });
  },
  get(k) { return this.mem ? Promise.resolve(this.mem.get(k)) : this.req('readonly', s => s.get(k)); },
  set(k, v) { if (this.mem) { this.mem.set(k, v); return Promise.resolve(); } return this.req('readwrite', s => s.put(v, k)); },
  del(k) { if (this.mem) { this.mem.delete(k); return Promise.resolve(); } return this.req('readwrite', s => s.delete(k)); },
  keys() { return this.mem ? Promise.resolve([...this.mem.keys()]) : this.req('readonly', s => s.getAllKeys()); }
};

/* Photos are stored once as Blobs under 'asset:<id>'; boards keep only the id, so autosave stays small.
   At runtime each photo object also carries `src` (an object URL), which is stripped before saving. */
const assetURLs = new Map(); // assetId -> object URL
async function putAsset(blob) {
  const id = uid();
  await DB.set('asset:' + id, blob);
  assetURLs.set(id, URL.createObjectURL(blob));
  return id;
}
async function assetURL(id) {
  if (assetURLs.has(id)) return assetURLs.get(id);
  const blob = await DB.get('asset:' + id); if (!blob) return null;
  const u = URL.createObjectURL(blob); assetURLs.set(id, u); return u;
}
// fills in `src` for photos; boards saved before assets existed (data URL in src) are converted. Returns true if converted.
async function hydrate(objects) {
  let migrated = false;
  for (const o of objects) {
    if (o.type !== 'image') continue;
    if (!o.assetId && o.src) { o.assetId = await putAsset(await (await fetch(o.src)).blob()); migrated = true; }
    if (o.assetId) o.src = (await assetURL(o.assetId)) || '';
  }
  return migrated;
}
const serialize = objs => objs.map(o => { if (o.type !== 'image') return o; const { src, ...rest } = o; return rest; });
// deletes photos no board (nor the open board's undo history) refers to any more
async function gcAssets() {
  const keys = (await DB.keys()).filter(k => typeof k === 'string' && k.startsWith('asset:'));
  if (!keys.length) return;
  const used = new Set(), mark = objs => { for (const o of objs || []) if (o.assetId) used.add(o.assetId); };
  for (const n of Object.values(tree.nodes)) {
    if (n.type !== 'board') continue;
    if (cur && cur.id === n.id) { mark(cur.objects); undoStack.forEach(mark); redoStack.forEach(mark); }
    else mark(((await DB.get('board:' + n.id)) || {}).objects);
  }
  for (const k of keys) {
    const id = k.slice(6); if (used.has(id)) continue;
    DB.del(k);
    if (assetURLs.has(id)) { URL.revokeObjectURL(assetURLs.get(id)); assetURLs.delete(id); }
  }
}

