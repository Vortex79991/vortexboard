const DRAW_TOOLS = new Set(['pen', 'marker', 'pencil', 'highlighter', 'calligraphy', 'spray', 'eraser']);
const COLORS = ['#1e1e1e', '#ffffff', '#e03131', '#f08c00', '#fcc419', '#2f9e44', '#1c7ed6', '#7048e8', '#e64980', '#868e96'];

