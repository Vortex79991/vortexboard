let holdTimer = null, suppressContextUntil = 0;
const HOLD_MS = 500, HOLD_SLOP = 6;

/* =========================================================
   Canvas setup & rendering
   ========================================================= */
const stage = $('#stage');
const cv = $('#board'), ctx = cv.getContext('2d');
const layer = document.createElement('canvas'), lctx = layer.getContext('2d');
const base = document.createElement('canvas'), bctx = base.getContext('2d');
let dpr = 1, W = 0, H = 0, baseValid = false;
let baseView = null;   // view the base cache was rendered with
let fastUntil = 0;     // during pan / pinch / wheel the cached bitmap is moved instead of redrawn

function resize() {
  const r = stage.getBoundingClientRect();
  dpr = Math.min(window.devicePixelRatio || 1, 2); W = r.width; H = r.height; // >2x costs memory on phones for no visible gain
  for (const c of [cv, layer, base]) { c.width = Math.max(1, Math.round(W * dpr)); c.height = Math.max(1, Math.round(H * dpr)); }
  cv.style.width = W + 'px'; cv.style.height = H + 'px';
  baseValid = false; render();
}
new ResizeObserver(resize).observe(stage);

let rq = false;
function requestRender() { if (!rq) { rq = true; requestAnimationFrame(() => { rq = false; render(); }); } }
function setView(c) { const v = cur.view; c.setTransform(dpr * v.z, 0, 0, dpr * v.z, dpr * v.x, dpr * v.y); }

function render() {
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.fillStyle = '#f3f3f0'; ctx.fillRect(0, 0, cv.width, cv.height);
  if (!cur) return;
  drawGrid();
  const v = cur.view, gesture = (drag && (drag.mode === 'pan' || drag.mode === 'pinch')) || Date.now() < fastUntil;
  const viewMoved = !baseView || baseView.x !== v.x || baseView.y !== v.y || baseView.z !== v.z;
  // committed objects live in `base`; it is redrawn only when they or the view change
  if (!baseValid || (viewMoved && !gesture)) {
    bctx.setTransform(1, 0, 0, 1, 0, 0); bctx.clearRect(0, 0, base.width, base.height);
    setView(bctx); for (const o of cur.objects) drawObj(bctx, o);
    baseValid = true; baseView = { ...v };
  }
  const k = v.z / baseView.z; // 1 unless a gesture is moving the stale bitmap
  ctx.setTransform(k, 0, 0, k, (v.x - baseView.x * k) * dpr, (v.y - baseView.y * k) * dpr);
  if (drawing) {
    lctx.setTransform(1, 0, 0, 1, 0, 0); lctx.clearRect(0, 0, layer.width, layer.height);
    lctx.drawImage(base, 0, 0);
    setView(lctx); drawObj(lctx, drawing); // drawn into a copy so the eraser can cut through it
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.drawImage(layer, 0, 0);
  } else ctx.drawImage(base, 0, 0);
  setView(ctx); drawSelection();
  drawNoteBadges();
  drawBrushCursor();
}

function drawGrid() {
  const v = cur.view; let step = 24 * v.z;
  while (step < 12) step *= 2;
  const ox = ((v.x % step) + step) % step, oy = ((v.y % step) + step) % step;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#d6d6d1';
  const s = 1.6;
  ctx.beginPath();
  for (let x = ox; x < W; x += step) for (let y = oy; y < H; y += step) ctx.rect(x - s / 2, y - s / 2, s, s);
  ctx.fill();
}

function drawObj(c, o) { if (o.type === 'image') drawImageObj(c, o); else drawStroke(c, o); }

function tracePath(c, p) {
  c.beginPath(); c.moveTo(p[0][0], p[0][1]);
  if (p.length < 3) {
    for (const q of p) c.lineTo(q[0], q[1]);
    if (p.length === 1) c.lineTo(p[0][0] + 0.01, p[0][1]);
    return;
  }
  for (let i = 1; i < p.length - 1; i++) {
    c.quadraticCurveTo(p[i][0], p[i][1], (p[i][0] + p[i + 1][0]) / 2, (p[i][1] + p[i + 1][1]) / 2);
  }
  const l = p[p.length - 1]; c.lineTo(l[0], l[1]);
}

function drawStroke(c, s) {
  const p = s.pts; if (!p || !p.length) return;
  c.save();
  c.globalAlpha = s.opacity / 100;
  c.strokeStyle = c.fillStyle = s.color;
  c.lineCap = 'round'; c.lineJoin = 'round'; c.lineWidth = s.size;
  switch (s.tool) {
    case 'eraser':
      c.globalCompositeOperation = 'destination-out'; c.globalAlpha = 1;
      tracePath(c, p); c.stroke(); break;
    case 'pen':
      tracePath(c, p); c.stroke(); break;
    case 'marker':
      c.globalAlpha *= 0.82; tracePath(c, p); c.stroke(); break;
    case 'highlighter':
      c.globalAlpha *= 0.42; c.globalCompositeOperation = 'multiply'; c.lineCap = 'square';
      tracePath(c, p); c.stroke(); break;
    case 'pencil': {
      c.lineWidth = Math.max(0.6, s.size * 0.35); c.globalAlpha *= 0.5;
      const j = s.size * 0.4;
      for (let k = 0; k < 3; k++) {
        const q = p.map((pt, i) => [pt[0] + (hash01(s.seed, i, k * 2) - 0.5) * j, pt[1] + (hash01(s.seed, i, k * 2 + 1) - 0.5) * j]);
        tracePath(c, q); c.stroke();
      }
      break;
    }
    case 'calligraphy': {
      const a = -Math.PI / 4, dx = Math.cos(a) * s.size / 2, dy = Math.sin(a) * s.size / 2;
      c.beginPath();
      for (let i = 1; i < p.length; i++) {
        const A = p[i - 1], B = p[i];
        const quad = [[A[0] - dx, A[1] - dy], [A[0] + dx, A[1] + dy], [B[0] + dx, B[1] + dy], [B[0] - dx, B[1] - dy]];
        if ((2 * dx) * (B[1] - A[1]) - (2 * dy) * (B[0] - A[0]) < 0) quad.reverse(); // keep one winding so overlaps union
        c.moveTo(quad[0][0], quad[0][1]); for (let k = 1; k < 4; k++) c.lineTo(quad[k][0], quad[k][1]); c.closePath();
      }
      c.fill();
      if (p.length === 1) { c.lineWidth = 1.5; c.beginPath(); c.moveTo(p[0][0] - dx, p[0][1] - dy); c.lineTo(p[0][0] + dx, p[0][1] + dy); c.stroke(); }
      break;
    }
    case 'spray': {
      const ds = Math.max(1, s.size / 30);
      c.beginPath();
      for (const d of s.dots || []) c.rect(d[0] - ds / 2, d[1] - ds / 2, ds, ds);
      c.fill(); break;
    }
  }
  c.restore();
}

/* ---------- images ---------- */
const imgCache = new Map(); // object id -> { img, ready, src, proc, key }
function getImg(o) {
  let e = imgCache.get(o.id);
  if (!e || e.src !== o.src) {
    e = { img: new Image(), ready: false, src: o.src, proc: null, key: null };
    e.img.onload = () => { e.ready = true; baseValid = false; requestRender(); };
    e.img.src = o.src;
    imgCache.set(o.id, e);
  }
  return e;
}
function defaultF() {
  return { opacity: 100, brightness: 100, contrast: 100, saturate: 100, hue: 0, blur: 0, grayscale: 0, sepia: 0, invert: 0,
    tint: '#5b8cff', tintAmt: 0, radius: 0, border: 0, borderColor: '#ffffff', shadow: 0 };
}
function processed(o) {
  const e = getImg(o); if (!e.ready) return null;
  const f = o.f, nw = e.img.naturalWidth || o.w, nh = e.img.naturalHeight || o.h;
  const blurPx = f.blur > 0 ? Math.round(f.blur * nw / o.w * 4) / 4 : 0;
  const key = [f.brightness, f.contrast, f.saturate, f.hue, f.grayscale, f.sepia, f.invert, f.tintAmt ? f.tint : '', f.tintAmt, blurPx].join('|');
  if (e.key === key) return e.proc;
  e.key = key;
  if (key === '100|100|100|0|0|0|0||0|0') { e.proc = e.img; return e.proc; }
  const c = e.proc instanceof HTMLCanvasElement ? e.proc : document.createElement('canvas');
  c.width = nw; c.height = nh;
  const x = c.getContext('2d');
  x.clearRect(0, 0, nw, nh);
  x.filter = `brightness(${f.brightness}%) contrast(${f.contrast}%) saturate(${f.saturate}%) hue-rotate(${f.hue}deg) grayscale(${f.grayscale}%) sepia(${f.sepia}%) invert(${f.invert}%)` + (blurPx ? ` blur(${blurPx}px)` : '');
  x.drawImage(e.img, 0, 0, nw, nh);
  x.filter = 'none';
  if (f.tintAmt > 0) {
    x.globalCompositeOperation = 'color'; x.globalAlpha = f.tintAmt / 100;
    x.fillStyle = f.tint; x.fillRect(0, 0, nw, nh);
    x.globalAlpha = 1; x.globalCompositeOperation = 'destination-in';
    x.drawImage(e.img, 0, 0, nw, nh);
    x.globalCompositeOperation = 'source-over';
  }
  e.proc = c; return c;
}
function rrect(c, x, y, w, h, r) {
  c.beginPath();
  if (r > 0 && c.roundRect) c.roundRect(x, y, w, h, r); else c.rect(x, y, w, h);
}
function drawImageObj(c, o) {
  const src = processed(o), f = o.f;
  c.save();
  c.translate(o.x + o.w / 2, o.y + o.h / 2); c.rotate(o.rot || 0); c.scale(o.flipX ? -1 : 1, o.flipY ? -1 : 1);
  const x = -o.w / 2, y = -o.h / 2, r = Math.min(f.radius || 0, Math.min(o.w, o.h) / 2);
  c.globalAlpha = f.opacity / 100;
  if (!src) { c.fillStyle = '#e4e4e8'; c.fillRect(x, y, o.w, o.h); c.restore(); return; }
  if (f.shadow > 0) {
    const t = c.getTransform(), k = Math.hypot(t.a, t.b);
    c.save(); c.shadowColor = 'rgba(0,0,0,.35)'; c.shadowBlur = f.shadow * k; c.shadowOffsetY = f.shadow * 0.35 * k;
    c.fillStyle = '#fff'; rrect(c, x, y, o.w, o.h, r); c.fill(); c.restore();
  }
  c.save();
  if (r > 0) { rrect(c, x, y, o.w, o.h, r); c.clip(); }
  c.drawImage(src, x, y, o.w, o.h);
  c.restore();
  if (f.border > 0) { c.lineWidth = f.border; c.strokeStyle = f.borderColor; rrect(c, x, y, o.w, o.h, r); c.stroke(); }
  c.restore();
}

/* ---------- geometry ---------- */
function axes(o) { const a = o.rot || 0; return { ux: [Math.cos(a), Math.sin(a)], uy: [-Math.sin(a), Math.cos(a)], cx: o.x + o.w / 2, cy: o.y + o.h / 2 }; }
function corners(o) {
  const { ux, uy, cx, cy } = axes(o);
  return [[-1, -1], [1, -1], [1, 1], [-1, 1]].map(([sx, sy]) => ({
    sx, sy, x: cx + sx * o.w / 2 * ux[0] + sy * o.h / 2 * uy[0], y: cy + sx * o.w / 2 * ux[1] + sy * o.h / 2 * uy[1]
  }));
}
function rotHandle(o) {
  const { uy, cx, cy } = axes(o), d = o.h / 2 + (touchUI() ? 40 : 28) / cur.view.z;
  return { x: cx - d * uy[0], y: cy - d * uy[1] };
}
function toLocal(o, p) {
  const { ux, uy, cx, cy } = axes(o), dx = p.x - cx, dy = p.y - cy;
  return { x: dx * ux[0] + dy * ux[1], y: dx * uy[0] + dy * uy[1] };
}
function hitImage(p) {
  for (let i = cur.objects.length - 1; i >= 0; i--) {
    const o = cur.objects[i]; if (o.type !== 'image') continue;
    const l = toLocal(o, p); if (Math.abs(l.x) <= o.w / 2 && Math.abs(l.y) <= o.h / 2) return o;
  }
  return null;
}
const toScreen = p => ({ x: p.x * cur.view.z + cur.view.x, y: p.y * cur.view.z + cur.view.y });
function hitHandle(o, sx, sy) {
  const rh = toScreen(rotHandle(o)), t = touchUI() ? 22 : 9; // fingers need bigger targets
  if (Math.hypot(rh.x - sx, rh.y - sy) < t + 1) return { type: 'rot' };
  for (const c of corners(o)) { const s = toScreen(c); if (Math.abs(s.x - sx) < t && Math.abs(s.y - sy) < t) return { type: 'scale', sx: c.sx, sy: c.sy }; }
  return null;
}
function objBounds(o) {
  if (o.type === 'image') {
    const cs = corners(o), pad = (o.f.border || 0) / 2 + (o.f.shadow || 0) * 1.6;
    return [Math.min(...cs.map(c => c.x)) - pad, Math.min(...cs.map(c => c.y)) - pad, Math.max(...cs.map(c => c.x)) + pad, Math.max(...cs.map(c => c.y)) + pad];
  }
  if (o.tool === 'eraser') return null;
  const pts = o.tool === 'spray' ? o.dots : o.pts; if (!pts || !pts.length) return null;
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  for (const p of pts) { if (p[0] < x0) x0 = p[0]; if (p[1] < y0) y0 = p[1]; if (p[0] > x1) x1 = p[0]; if (p[1] > y1) y1 = p[1]; }
  const r = o.tool === 'spray' ? 2 : o.size / 2 + 2;
  return [x0 - r, y0 - r, x1 + r, y1 + r];
}
function contentBounds(objs) {
  let b = null;
  for (const o of objs) { const q = objBounds(o); if (!q) continue; b = b ? [Math.min(b[0], q[0]), Math.min(b[1], q[1]), Math.max(b[2], q[2]), Math.max(b[3], q[3])] : q; }
  return b;
}

/* ---------- overlay ---------- */
const getSel = () => cur && selectedId ? cur.objects.find(o => o.id === selectedId) || null : null;
function drawSelection() {
  const o = getSel(); if (!o) return;
  const z = cur.view.z, cs = corners(o), rh = rotHandle(o);
  ctx.save();
  ctx.strokeStyle = '#5b8cff'; ctx.lineWidth = 1.5 / z;
  ctx.beginPath(); cs.forEach((p, i) => i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)); ctx.closePath(); ctx.stroke();
  ctx.beginPath(); ctx.moveTo((cs[0].x + cs[1].x) / 2, (cs[0].y + cs[1].y) / 2); ctx.lineTo(rh.x, rh.y); ctx.stroke();
  ctx.fillStyle = '#fff'; const big = touchUI(), hs = (big ? 14 : 9) / z;
  for (const p of cs) { ctx.beginPath(); ctx.rect(p.x - hs / 2, p.y - hs / 2, hs, hs); ctx.fill(); ctx.stroke(); }
  ctx.beginPath(); ctx.arc(rh.x, rh.y, (big ? 8 : 5.5) / z, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  ctx.restore();
}
// The cursor itself is a ring the size of the brush. Rings bigger than CURSOR_MAX are too large
// for a system cursor, so then the cursor shrinks to a small ring and the big one is painted on the canvas.
const CURSOR_MAX = 96;
const brushDiameter = () => Math.max(1, st.sizes[st.tool] * (cur ? cur.view.z : 1));
function ringCursor(d) {
  const s = Math.ceil(d) + 4, c = s / 2, r = d / 2;
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${s}" height="${s}">` +
    `<circle cx="${c}" cy="${c}" r="${r}" fill="none" stroke="rgba(255,255,255,.9)" stroke-width="3"/>` +
    `<circle cx="${c}" cy="${c}" r="${r}" fill="none" stroke="rgba(0,0,0,.75)" stroke-width="1"/></svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}") ${Math.floor(c)} ${Math.floor(c)}, crosshair`;
}
function drawBrushCursor() {
  if (!cursorPos || !DRAW_TOOLS.has(st.tool) || spaceDown || (drag && drag.mode === 'pan')) return;
  if (brushDiameter() <= CURSOR_MAX) return;
  const r = brushDiameter() / 2;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.beginPath(); ctx.arc(cursorPos.x, cursorPos.y, r, 0, Math.PI * 2);
  ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(255,255,255,.8)'; ctx.stroke();
  ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(0,0,0,.6)'; ctx.stroke();
}

/* =========================================================
   History & saving
   ========================================================= */
const snap = () => cur.objects.map(o => o.type === 'image' ? { ...o, f: { ...o.f } } : o);
function pushHistory(s) {
  undoStack.push(s || snap()); if (undoStack.length > 100) undoStack.shift();
  redoStack.length = 0; updateHistBtns();
}
function undo() { if (!cur || !undoStack.length) return; redoStack.push(snap()); cur.objects = undoStack.pop(); afterHistory(); }
function redo() { if (!cur || !redoStack.length) return; undoStack.push(snap()); cur.objects = redoStack.pop(); afterHistory(); }
function afterHistory() { if (!getSel()) selectedId = null; updatePanel(); changed(); }
function updateHistBtns() {
  const u = $('#tb-undo'), r = $('#tb-redo');
  if (u) u.disabled = !undoStack.length; if (r) r.disabled = !redoStack.length;
}
function changed() { baseValid = false; scheduleSave(); requestRender(); updateHistBtns(); }

let saveT;
function scheduleSave() { clearTimeout(saveT); saveT = setTimeout(saveNow, 400); }
function saveNow() { clearTimeout(saveT); if (!cur) return Promise.resolve(); return DB.set('board:' + cur.id, { objects: serialize(cur.objects), view: cur.view }).catch(err => toast('Не удалось сохранить: ' + err.message)); }
const saveTree = () => DB.set('tree', tree);
window.addEventListener('beforeunload', saveNow);
document.addEventListener('visibilitychange', () => { if (document.hidden) saveNow(); });

/* =========================================================
   Pointer interaction
   ========================================================= */
function evPos(e) {
  const r = cv.getBoundingClientRect(), sx = e.clientX - r.left, sy = e.clientY - r.top, v = cur.view;
  return { sx, sy, x: (sx - v.x) / v.z, y: (sy - v.y) / v.z };
}

/* touch: two fingers pan + pinch-zoom the board */
const pointers = new Map();   // active pointer id -> client position
let lastPointerType = 'mouse';
let pressStart = { x: 0, y: 0 };
const touchUI = () => lastPointerType === 'touch';
function startPinch() {
  clearTimeout(holdTimer); clearInterval(sprayTimer);
  if (drawing) { // keep a real stroke, drop the dot the first finger just made
    if (drawing.pts.length > 12) { pushHistory(); cur.objects.push(drawing); changed(); }
    drawing = null;
  }
  if (drag && drag.moved && drag.before) { cur.objects = drag.before; baseValid = false; } // first finger wasn't meant to move a photo
  const [a, b] = [...pointers.values()], r = cv.getBoundingClientRect();
  drag = { mode: 'pinch', d0: Math.hypot(a.x - b.x, a.y - b.y) || 1, v0: { ...cur.view },
    m0: { x: (a.x + b.x) / 2 - r.left, y: (a.y + b.y) / 2 - r.top } };
  hideMenu(); requestRender();
}
function updatePinch() {
  const [a, b] = [...pointers.values()], r = cv.getBoundingClientRect(), { d0, m0, v0 } = drag;
  const m = { x: (a.x + b.x) / 2 - r.left, y: (a.y + b.y) / 2 - r.top };
  const z = clamp(v0.z * Math.hypot(a.x - b.x, a.y - b.y) / d0, 0.1, 8);
  const wx = (m0.x - v0.x) / v0.z, wy = (m0.y - v0.y) / v0.z;
  cur.view = { z, x: m.x - wx * z, y: m.y - wy * z };
  $('#zoomVal').textContent = Math.round(z * 100) + '%';
  scheduleSave(); requestRender();
}
function startHold(hit, e) {
  clearTimeout(holdTimer);
  holdTimer = setTimeout(() => {
    holdTimer = null;
    if (drag && (drag.o !== hit || drag.moved)) return;
    if (drawing && drawing.pts.length > 2) return;
    drag = null; drawing = null; clearInterval(sprayTimer); suppressContextUntil = Date.now() + 800;
    requestRender();
    showObjectMenu(hit, e.clientX, e.clientY);
    if (e.pointerType === 'touch' && navigator.vibrate) navigator.vibrate(15);
  }, HOLD_MS);
}

cv.addEventListener('mousedown', e => { if (e.button === 1) e.preventDefault(); });
cv.addEventListener('pointerdown', e => {
  if (!cur) return;
  hideNoteTip();
  lastPointerType = e.pointerType || 'mouse';
  if (e.button === 2) return;
  hideMenu(); closeDrawer();
  try { cv.setPointerCapture(e.pointerId); } catch (err) {} // can throw if the pointer is already gone
  if (e.pointerType !== 'touch') pointers.clear(); // a mouse/pen has one pointer; never let a stale entry block ending a stroke
  pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
  if (e.pointerType === 'touch' && pointers.size === 2) { startPinch(); return; }
  if (pointers.size > 1) return;
  const p = evPos(e);
  pressStart = { x: p.sx, y: p.sy };
  if (e.button === 1 || spaceDown || st.tool === 'hand') {
    drag = { mode: 'pan', sx: e.clientX, sy: e.clientY, vx: cur.view.x, vy: cur.view.y }; updateCursor(); return;
  }
  if (st.tool === 'select') {
    const sel = getSel(), h = sel && hitHandle(sel, p.sx, p.sy);
    if (h) {
      const before = snap();
      if (h.type === 'rot') {
        const { cx, cy } = axes(sel);
        drag = { mode: 'rot', o: sel, before, cx, cy, a0: Math.atan2(p.y - cy, p.x - cx), r0: sel.rot || 0 };
      } else {
        const { ux, uy, cx, cy } = axes(sel);
        drag = { mode: 'scale', o: sel, before, sx: h.sx, sy: h.sy, ux, uy, w0: sel.w, h0: sel.h,
          ax: cx - h.sx * sel.w / 2 * ux[0] - h.sy * sel.h / 2 * uy[0], ay: cy - h.sx * sel.w / 2 * ux[1] - h.sy * sel.h / 2 * uy[1] };
      }
      return;
    }
    const hit = hitImage(p);
    select(hit ? hit.id : null);
    if (hit) {
      drag = { mode: 'move', o: hit, before: snap(), dx: p.x - hit.x, dy: p.y - hit.y, moved: false, sx0: p.sx, sy0: p.sy };
      startHold(hit, e); // press and hold (phones) opens the object menu
    }
    return;
  }
  if (DRAW_TOOLS.has(st.tool)) {
    if (selectedId) select(null);
    drawing = { type: 'stroke', id: uid(), tool: st.tool, color: st.color, size: st.sizes[st.tool], opacity: st.opacity,
      pts: [[p.x, p.y]], seed: (Math.random() * 1e9) | 0 };
    if (e.pointerType === 'touch') { const hit = hitImage(p); if (hit) startHold(hit, e); } // holding still on a photo = its menu
    baseValid = false;
    if (st.tool === 'spray') {
      drawing.dots = []; sprayAt(p.x, p.y);
      clearInterval(sprayTimer);
      sprayTimer = setInterval(() => { if (drawing && drawing.tool === 'spray') { const l = drawing.pts[drawing.pts.length - 1]; sprayAt(l[0], l[1]); requestRender(); } }, 30);
    }
    requestRender();
  }
});

function sprayAt(x, y) {
  const R = drawing.size / 2, n = Math.round(6 + R * 0.6);
  for (let i = 0; i < n; i++) {
    const a = Math.random() * Math.PI * 2, d = R * Math.sqrt(Math.random());
    drawing.dots.push([x + Math.cos(a) * d, y + Math.sin(a) * d]);
  }
}

cv.addEventListener('pointermove', e => {
  if (!cur) return;
  if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
  if (drag && drag.mode === 'pinch') { if (pointers.size >= 2) updatePinch(); return; }
  const p = evPos(e);
  cursorPos = e.pointerType === 'touch' ? null : { x: p.sx, y: p.sy };
  if (drag) {
    hideNoteTip();
    const o = drag.o;
    if (drag.mode === 'pan') {
      cur.view.x = drag.vx + (e.clientX - drag.sx); cur.view.y = drag.vy + (e.clientY - drag.sy); scheduleSave();
    } else if (drag.mode === 'move') {
      if (!drag.moved && Math.hypot(p.sx - drag.sx0, p.sy - drag.sy0) < HOLD_SLOP) return; // still a press, maybe a hold
      clearTimeout(holdTimer);
      o.x = p.x - drag.dx; o.y = p.y - drag.dy; drag.moved = true;
    } else if (drag.mode === 'rot') {
      let r = drag.r0 + Math.atan2(p.y - drag.cy, p.x - drag.cx) - drag.a0;
      if (e.shiftKey) r = Math.round(r / (Math.PI / 12)) * (Math.PI / 12);
      o.rot = r; drag.moved = true;
    } else if (drag.mode === 'scale') {
      const { ux, uy, sx, sy, w0, h0, ax, ay } = drag;
      const dx = p.x - ax, dy = p.y - ay;
      const lx = (dx * ux[0] + dy * ux[1]) * sx, ly = (dx * uy[0] + dy * uy[1]) * sy;
      let nw, nh;
      if (e.shiftKey) { nw = Math.max(10, lx); nh = Math.max(10, ly); }
      else { const k = Math.max(10 / Math.min(w0, h0), (lx * w0 + ly * h0) / (w0 * w0 + h0 * h0)); nw = w0 * k; nh = h0 * k; }
      const cx = ax + sx * nw / 2 * ux[0] + sy * nh / 2 * uy[0], cy = ay + sx * nw / 2 * ux[1] + sy * nh / 2 * uy[1];
      o.w = nw; o.h = nh; o.x = cx - nw / 2; o.y = cy - nh / 2; drag.moved = true;
    }
    if (drag.mode !== 'pan') baseValid = false;
    requestRender(); return;
  }
  if (drawing) {
    const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [e];
    for (const ce of evs.length ? evs : [e]) {
      const q = evPos(ce), l = drawing.pts[drawing.pts.length - 1];
      if (Math.hypot(q.x - l[0], q.y - l[1]) * cur.view.z < 1.2) continue;
      if (holdTimer && Math.hypot(q.sx - pressStart.x, q.sy - pressStart.y) > HOLD_SLOP) { clearTimeout(holdTimer); holdTimer = null; }
      drawing.pts.push([q.x, q.y]);
      if (drawing.tool === 'spray') sprayAt(q.x, q.y);
    }
  } else { updateCursor(p); updateNoteTip(p); }
  requestRender();
});

function endPointer(e) {
  pointers.delete(e.pointerId);
  if (drag && drag.mode === 'pinch') { // wait for every finger to lift before anything else starts
    if (!pointers.size) { drag = null; requestRender(); }
    return;
  }
  if (pointers.size) return;
  clearInterval(sprayTimer); clearTimeout(holdTimer); holdTimer = null;
  if (drawing) {
    pushHistory(); cur.objects.push(drawing); drawing = null; changed();
  }
  if (drag) {
    const tapped = drag.mode === 'move' && !drag.moved;
    if (drag.moved && drag.before) { pushHistory(drag.before); changed(); }
    drag = null; updateCursor();
    if (tapped && e.pointerType === 'touch') updateNoteTip(evPos(e)); // phones have no hover: a tap shows the note card
  }
  requestRender();
}
cv.addEventListener('pointerup', endPointer);
cv.addEventListener('pointercancel', endPointer);
cv.addEventListener('pointerleave', () => { cursorPos = null; hideNoteTip(); requestRender(); });

function updateCursor(p) {
  let c = 'default';
  if (drag && drag.mode === 'pan') c = 'grabbing';
  else if (spaceDown || st.tool === 'hand') c = 'grab';
  else if (DRAW_TOOLS.has(st.tool)) { const d = brushDiameter(); c = ringCursor(d > CURSOR_MAX ? 10 : Math.max(8, d)); }
  else if (st.tool === 'select' && p && cur) {
    const sel = getSel(), h = sel && hitHandle(sel, p.sx, p.sy);
    if (h) c = h.type === 'rot' ? 'grab' : (h.sx * h.sy > 0 ? 'nwse-resize' : 'nesw-resize');
    else if (hitImage(p)) c = 'move';
  }
  if (cv.style.cursor !== c) cv.style.cursor = c;
}

/* zoom & pan with wheel */
let wheelT;
cv.addEventListener('wheel', e => {
  if (!cur) return;
  e.preventDefault(); hideNoteTip();
  const r = cv.getBoundingClientRect();
  fastUntil = Date.now() + 150; clearTimeout(wheelT); wheelT = setTimeout(requestRender, 170); // sharp redraw once the wheel stops
  if (!e.ctrlKey && e.deltaMode === 0 && Math.abs(e.deltaX) > 0) { // trackpad two-finger pan
    cur.view.x -= e.deltaX; cur.view.y -= e.deltaY; scheduleSave(); requestRender(); return;
  }
  const k = e.ctrlKey ? 0.01 : 0.0015;
  zoomAt(e.clientX - r.left, e.clientY - r.top, Math.exp(-e.deltaY * k * (e.deltaMode === 1 ? 30 : 1)));
}, { passive: false });

function zoomAt(sx, sy, f) {
  const v = cur.view, nz = clamp(v.z * f, 0.1, 8);
  const wx = (sx - v.x) / v.z, wy = (sy - v.y) / v.z;
  v.z = nz; v.x = sx - wx * nz; v.y = sy - wy * nz;
  $('#zoomVal').textContent = Math.round(nz * 100) + '%';
  scheduleSave(); requestRender(); updateCursor();
}
function zoomFit() {
  const b = contentBounds(cur.objects);
  if (!b) { cur.view = { x: 0, y: 0, z: 1 }; } else {
    const bw = b[2] - b[0], bh = b[3] - b[1];
    const z = clamp(Math.min((W - 160) / bw, (H - 200) / bh), 0.1, 2);
    cur.view = { z, x: W / 2 - (b[0] + bw / 2) * z, y: H / 2 - (b[1] + bh / 2) * z };
  }
  $('#zoomVal').textContent = Math.round(cur.view.z * 100) + '%';
  baseValid = false; scheduleSave(); requestRender(); updateCursor();
}

/* right click on the board → save PNG */
/* right click on a photo → its menu (edit / note); anywhere else on the board → save PNG */
cv.addEventListener('contextmenu', e => {
  e.preventDefault();
  if (!cur || Date.now() < suppressContextUntil) return;
  const hit = hitImage(evPos(e));
  if (hit) showObjectMenu(hit, e.clientX, e.clientY);
  else exportBoard(cur.id);
});

/* =========================================================
   Images: import, drop, paste
   ========================================================= */
function loadImg(src) { return new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src; }); }
async function addImageFile(file, cx, cy) {
  try {
    const tmp = URL.createObjectURL(file);
    let img;
    try { img = await loadImg(tmp); } finally { URL.revokeObjectURL(tmp); }
    let nw = img.naturalWidth || 400, nh = img.naturalHeight || 300, blob = file;
    const MAX = 2048; // phone photos are 4000px+; this keeps memory and storage sane
    if (Math.max(nw, nh) > MAX || !/^image\/(png|jpeg|webp|gif)$/.test(file.type)) {
      const s = Math.min(1, MAX / Math.max(nw, nh));
      const c = document.createElement('canvas'); c.width = Math.round(nw * s); c.height = Math.round(nh * s);
      c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
      blob = await new Promise(r => c.toBlob(r, file.type === 'image/png' ? 'image/png' : 'image/jpeg', 0.9));
      nw = c.width; nh = c.height;
    }
    const assetId = await putAsset(blob), src = assetURLs.get(assetId);
    img = await loadImg(src);
    const k = Math.min(1, (Math.min(520, W * 0.7) / cur.view.z) / Math.max(nw, nh));
    const w = nw * k, h = nh * k;
    const o = { type: 'image', id: uid(), name: file.name || 'image', assetId, src, x: cx - w / 2, y: cy - h / 2, w, h, rot: 0, flipX: false, flipY: false, f: defaultF() };
    pushHistory();
    cur.objects.push(o);
    imgCache.set(o.id, { img, ready: true, src, proc: null, key: null });
    setTool('select'); openPanel(o.id); changed();
    toast('ПКМ или удержание по фото — меню: настройки и заметки');
  } catch (err) { toast('Не удалось загрузить изображение'); }
}
async function addFiles(files, sx, sy) {
  files = [...files].filter(f => f.type.startsWith('image/'));
  if (!files.length) return;
  if (!cur) await createNode('board', targetParent(), false);
  const v = cur.view;
  const wx = (sx - v.x) / v.z, wy = (sy - v.y) / v.z;
  for (let i = 0; i < files.length; i++) await addImageFile(files[i], wx + i * 36 / v.z, wy + i * 36 / v.z);
}
const hasFiles = e => e.dataTransfer && [...e.dataTransfer.types].includes('Files');
let dragDepth = 0;
stage.addEventListener('dragenter', e => { if (hasFiles(e)) { dragDepth++; stage.classList.add('dropping'); } });
stage.addEventListener('dragleave', e => { if (hasFiles(e) && --dragDepth <= 0) { dragDepth = 0; stage.classList.remove('dropping'); } });
stage.addEventListener('dragover', e => { if (hasFiles(e)) { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; } });
stage.addEventListener('drop', e => {
  if (!hasFiles(e)) return;
  e.preventDefault(); dragDepth = 0; stage.classList.remove('dropping');
  const r = cv.getBoundingClientRect();
  addFiles(e.dataTransfer.files, e.clientX - r.left, e.clientY - r.top);
});
window.addEventListener('dragover', e => { if (hasFiles(e)) e.preventDefault(); });
window.addEventListener('drop', e => { if (hasFiles(e)) e.preventDefault(); });
document.addEventListener('paste', e => {
  if (/input|textarea/i.test(document.activeElement.tagName)) return;
  const files = [...(e.clipboardData?.files || [])];
  if (files.length) { e.preventDefault(); addFiles(files, W / 2, H / 2); }
});
$('#fileInput').addEventListener('change', e => { addFiles(e.target.files, W / 2, H / 2); e.target.value = ''; });

/* =========================================================
   Export PNG
   ========================================================= */
function safeName(n) { return (n || 'board').replace(/[\\/:*?"<>|]+/g, '_').trim() || 'board'; }
function download(blob, name) {
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 3000);
}
async function renderPNG(objects, transparent) {
  await Promise.all(objects.filter(o => o.type === 'image').map(o => new Promise(r => {
    const e = getImg(o); if (e.ready) return r();
    e.img.addEventListener('load', r, { once: true }); e.img.addEventListener('error', r, { once: true });
  })));
  const b = contentBounds(objects); if (!b) return null;
  const pad = transparent ? 0 : 40;
  const bw = b[2] - b[0] + pad * 2, bh = b[3] - b[1] + pad * 2;
  let s = Math.min(2, 8000 / Math.max(bw, bh));
  if (bw * bh * s * s > 50e6) s = Math.sqrt(50e6 / (bw * bh));
  const out = document.createElement('canvas'), lay = document.createElement('canvas');
  out.width = lay.width = Math.max(1, Math.round(bw * s)); out.height = lay.height = Math.max(1, Math.round(bh * s));
  const l = lay.getContext('2d'), x = out.getContext('2d');
  l.setTransform(s, 0, 0, s, (pad - b[0]) * s, (pad - b[1]) * s);
  for (const o of objects) drawObj(l, o);
  if (!transparent) { x.fillStyle = '#ffffff'; x.fillRect(0, 0, out.width, out.height); }
  x.drawImage(lay, 0, 0);
  return new Promise(r => out.toBlob(r, 'image/png'));
}
async function exportBoard(id) {
  const node = tree.nodes[id]; if (!node) return;
  let objects;
  if (cur && cur.id === id) objects = drawing ? [...cur.objects, drawing] : cur.objects;
  else { objects = ((await DB.get('board:' + id)) || {}).objects || []; await hydrate(objects); }
  const blob = await renderPNG(objects, false);
  if (!blob) { toast(`Доска «${node.name}» пустая — нечего сохранять`); return; }
  if (await deliverPNG(blob, safeName(node.name) + '.png') === 'downloaded') toast(`Доска «${node.name}» сохранена как PNG`);
}
async function exportImage(o) {
  const blob = await renderPNG([o], true);
  if (blob && await deliverPNG(blob, safeName((o.name || 'image').replace(/\.\w+$/, '')) + '-edited.png') === 'downloaded') toast('Фото сохранено как PNG');
}

/* =========================================================
   Selection & properties panel
   ========================================================= */
function select(id) {
  if (id !== selectedId) panelOpen = false; // touching another photo (or the board) closes the panel
  selectedId = id; updatePanel(); requestRender();
}
function openPanel(id) { select(id); panelOpen = true; updatePanel(); }

const FILTER_ROWS = [
  ['opacity', 'Непрозрачность', 0, 100, '%'],
  ['brightness', 'Яркость', 0, 200, '%'],
  ['contrast', 'Контраст', 0, 200, '%'],
  ['saturate', 'Насыщенность', 0, 300, '%'],
  ['hue', 'Оттенок', -180, 180, '°'],
  ['blur', 'Размытие', 0, 30, 'px'],
  ['grayscale', 'Ч/Б', 0, 100, '%'],
  ['sepia', 'Сепия', 0, 100, '%'],
  ['invert', 'Инверсия', 0, 100, '%']
];
const STYLE_ROWS = [
  ['radius', 'Скругление', 0, 300, 'px'],
  ['border', 'Обводка', 0, 40, 'px'],
  ['shadow', 'Тень', 0, 60, 'px']
];
const PRESETS = {
  'Оригинал': {},
  'Ч/Б': { grayscale: 100, contrast: 115 },
  'Винтаж': { sepia: 55, contrast: 92, brightness: 106, saturate: 80 },
  'Холод': { hue: -12, saturate: 110, tint: '#3b82f6', tintAmt: 20 },
  'Тепло': { tint: '#f59e0b', tintAmt: 22, saturate: 115 },
  'Ярко': { saturate: 170, contrast: 118 },
  'Негатив': { invert: 100 }
};
const rowHTML = ([k, label, min, max]) => `<div class="prow"><span>${label}</span><input type="range" data-k="${k}" min="${min}" max="${max}" step="1"><span class="val" data-v="${k}"></span></div>`;

function buildPanel() {
  $('#props').innerHTML = `
    <div class="ptitle"><span>Фото</span><button class="tbtn" data-act="close" title="Снять выделение" style="width:28px;height:28px">${ic('plus').replace('class="i"', 'class="i" style="transform:rotate(45deg)"')}</button></div>
    <h4>Быстрые фильтры</h4>
    <div class="presets">${Object.keys(PRESETS).map(n => `<button class="chip" data-preset="${n}">${n}</button>`).join('')}</div>
    <h4>Цвет и свет</h4>
    ${FILTER_ROWS.map(rowHTML).join('')}
    <div class="prow"><span>Тонирование</span><input type="range" data-k="tintAmt" min="0" max="100"><span class="val" data-v="tintAmt"></span></div>
    <div class="prow"><span>Цвет тона</span><input type="color" data-k="tint"><span></span></div>
    <h4>Оформление</h4>
    ${STYLE_ROWS.map(rowHTML).join('')}
    <div class="prow"><span>Цвет обводки</span><input type="color" data-k="borderColor"><span></span></div>
    <h4>Действия</h4>
    <div class="acts">
      <button class="tbtn" data-act="flipX" data-tip="Отразить ↔">${ic('flipH')}</button>
      <button class="tbtn" data-act="flipY" data-tip="Отразить ↕">${ic('flipV')}</button>
      <button class="tbtn" data-act="rot90" data-tip="Повернуть 90°">${ic('rotate')}</button>
      <button class="tbtn" data-act="dup" data-tip="Дублировать (Ctrl+D)">${ic('copy')}</button>
      <button class="tbtn danger" data-act="del" data-tip="Удалить (Del)">${ic('trash')}</button>
      <button class="tbtn" data-act="front" data-tip="На передний план">${ic('toFront')}</button>
      <button class="tbtn" data-act="fwd" data-tip="Вперёд">${ic('up')}</button>
      <button class="tbtn" data-act="bwd" data-tip="Назад">${ic('down')}</button>
      <button class="tbtn" data-act="back" data-tip="На задний план">${ic('toBack')}</button>
      <button class="tbtn" data-act="reset" data-tip="Сбросить всё">${ic('reset')}</button>
    </div>
    <div class="wide"><button class="wbtn" data-act="savePng">${ic('download')} Сохранить фото PNG</button></div>`;
}
function updatePanel() {
  const o = getSel(), p = $('#props');
  p.classList.toggle('show', !!o && panelOpen);
  syncBack();
  if (!o) return;
  p.querySelectorAll('[data-k]').forEach(inp => { inp.value = o.f[inp.dataset.k]; });
  p.querySelectorAll('[data-v]').forEach(sp => {
    const k = sp.dataset.v, row = [...FILTER_ROWS, ...STYLE_ROWS].find(r => r[0] === k);
    sp.textContent = Math.round(o.f[k]) + (row ? row[4] : '%');
  });
}
let panelSnap = null;
$('#props').addEventListener('input', e => {
  const k = e.target.dataset.k, o = getSel(); if (!k || !o) return;
  if (!panelSnap) panelSnap = snap();
  o.f[k] = e.target.type === 'color' ? e.target.value : +e.target.value;
  if (k === 'tint' && !o.f.tintAmt) o.f.tintAmt = 35;
  updatePanel(); baseValid = false; requestRender(); scheduleSave();
});
$('#props').addEventListener('change', () => { if (panelSnap) { pushHistory(panelSnap); panelSnap = null; } });
$('#props').addEventListener('click', e => {
  const o = getSel(); if (!o) return;
  const pr = e.target.closest('[data-preset]');
  if (pr) {
    pushHistory();
    const keep = { radius: o.f.radius, border: o.f.border, borderColor: o.f.borderColor, shadow: o.f.shadow, opacity: o.f.opacity };
    o.f = { ...defaultF(), ...keep, ...PRESETS[pr.dataset.preset] };
    updatePanel(); changed(); return;
  }
  const b = e.target.closest('[data-act]'); if (!b) return;
  imageAction(b.dataset.act);
});
function imageAction(act) {
  const o = getSel(); if (!o) return;
  if (act === 'close') { panelOpen = false; return updatePanel(); }
  if (act === 'savePng') return exportImage(o);
  pushHistory();
  const objs = cur.objects, j = objs.findIndex(x => x.id === o.id);
  const t = objs[j]; // same object; history snap holds copies
  switch (act) {
    case 'flipX': t.flipX = !t.flipX; break;
    case 'flipY': t.flipY = !t.flipY; break;
    case 'rot90': t.rot = ((t.rot || 0) + Math.PI / 2) % (Math.PI * 2); break;
    case 'dup': {
      const c = { ...t, id: uid(), f: { ...t.f }, x: t.x + 30 / cur.view.z, y: t.y + 30 / cur.view.z };
      objs.push(c); selectedId = c.id; break;
    }
    case 'del': objs.splice(j, 1); selectedId = null; break;
    case 'front': objs.splice(j, 1); objs.push(t); break;
    case 'back': objs.splice(j, 1); objs.unshift(t); break;
    case 'fwd': if (j < objs.length - 1) { objs[j] = objs[j + 1]; objs[j + 1] = t; } break;
    case 'bwd': if (j > 0) { objs[j] = objs[j - 1]; objs[j - 1] = t; } break;
    case 'reset': t.f = defaultF(); t.rot = 0; t.flipX = t.flipY = false; break;
  }
  updatePanel(); changed();
}

/* =========================================================
   Toolbar & bottom bar
   ========================================================= */
function buildToolbar() {
  const tb = $('#toolbar');
  tb.innerHTML = TOOLS.map(t => t === '-' ? '<div class="sep"></div>' :
    `<button class="tbtn" data-tool="${t.id}" data-tip="${t.name} (${t.key})">${ic(t.icon)}</button>`).join('') +
    `<div class="sep"></div>
     <button class="tbtn" id="tb-undo" data-tip="Отменить (Ctrl+Z)">${ic('undo')}</button>
     <button class="tbtn" id="tb-redo" data-tip="Повторить (Ctrl+Y)">${ic('redo')}</button>
     <div class="sep"></div>
     <button class="tbtn" id="tb-import" data-tip="Добавить фото">${ic('image')}</button>
     <button class="tbtn" id="tb-export" data-tip="Сохранить PNG (ПКМ / Ctrl+S)">${ic('download')}</button>
     <button class="tbtn" id="tb-clear" data-tip="Очистить доску">${ic('clear')}</button>`;
  tb.addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    if (b.dataset.tool) setTool(b.dataset.tool);
    else if (b.id === 'tb-undo') undo();
    else if (b.id === 'tb-redo') redo();
    else if (b.id === 'tb-import') $('#fileInput').click();
    else if (b.id === 'tb-export') exportBoard(cur.id);
    else if (b.id === 'tb-clear') clearBoard();
  });

  $('#colors').innerHTML = COLORS.map(c => `<button class="sw" data-c="${c}" style="background:${c}" title="${c}"></button>`).join('') +
    `<label class="sw custom" title="Свой цвет"><input type="color" id="customColor"></label>`;
  $('#colors').addEventListener('click', e => { const b = e.target.closest('[data-c]'); if (b) setColor(b.dataset.c); });
  $('#customColor').addEventListener('input', e => setColor(e.target.value));
  $('#size').addEventListener('input', e => { if (st.sizes[st.tool] != null) { st.sizes[st.tool] = +e.target.value; syncControls(); saveTools(); requestRender(); } });
  $('#opacity').addEventListener('input', e => { st.opacity = +e.target.value; syncControls(); saveTools(); });

  $('#zoomIn').innerHTML = ic('plus'); $('#zoomOut').innerHTML = ic('minus'); $('#zoomFit').innerHTML = ic('fit');
  $('#zoomIn').onclick = () => zoomAt(W / 2, H / 2, 1.25);
  $('#zoomOut').onclick = () => zoomAt(W / 2, H / 2, 0.8);
  $('#zoomVal').onclick = () => zoomAt(W / 2, H / 2, 1 / cur.view.z);
  $('#zoomFit').onclick = zoomFit;
}
function setTool(t) {
  st.tool = t; saveTools();
  if (t !== 'select' && selectedId && DRAW_TOOLS.has(t)) select(null);
  syncControls(); updateCursor(); requestRender();
}
function setColor(c) { st.color = c; if (st.tool === 'eraser' || !DRAW_TOOLS.has(st.tool)) st.tool = 'pen'; syncControls(); saveTools(); }
function syncControls() {
  document.querySelectorAll('[data-tool]').forEach(b => b.classList.toggle('on', b.dataset.tool === st.tool));
  document.querySelectorAll('.sw[data-c]').forEach(b => b.classList.toggle('on', b.dataset.c.toLowerCase() === st.color.toLowerCase()));
  const custom = document.querySelector('.sw.custom');
  const isCustom = !COLORS.some(c => c.toLowerCase() === st.color.toLowerCase());
  custom.classList.toggle('on', isCustom);
  $('#customColor').value = st.color;
  const size = st.sizes[st.tool], hasSize = size != null;
  $('#size').disabled = !hasSize; $('#size').value = hasSize ? size : 1;
  $('#sizeVal').textContent = hasSize ? size : '—';
  $('#opacity').value = st.opacity; $('#opacityVal').textContent = st.opacity + '%';
  const d = $('#preview i'), px = hasSize ? clamp(size, 2, 30) : 0;
  d.style.width = d.style.height = px + 'px';
  d.style.background = st.tool === 'eraser' ? 'transparent' : st.color;
  d.style.boxShadow = st.tool === 'eraser' ? 'inset 0 0 0 1.5px #9aa0ab' : (st.color.toLowerCase() === '#ffffff' ? 'inset 0 0 0 1px #ccc' : 'none');
  d.style.opacity = st.opacity / 100;
  updateCursor();
}
function clearBoard() {
  if (!cur || !cur.objects.length) return;
  pushHistory(); cur.objects = []; selectedId = null; updatePanel(); changed();
  toast('Доска очищена — Ctrl+Z, чтобы вернуть');
}

/* =========================================================
   Project tree
   ========================================================= */
const treeEl = $('#tree');
const TYPE_ORDER = { folder: 0, board: 1, note: 2 };
const kids = pid => Object.values(tree.nodes).filter(n => n.parent === pid)
  .sort((a, b) => (TYPE_ORDER[a.type] - TYPE_ORDER[b.type]) || a.created - b.created);
function isDesc(id, anc) { let n = tree.nodes[id]; while (n) { if (n.parent === anc) return true; n = tree.nodes[n.parent]; } return false; }
function targetParent() { return targetFolder && tree.nodes[targetFolder] ? targetFolder : null; }
function pathOf(id) { const out = []; let n = tree.nodes[id]; while (n) { out.unshift(n.name); n = tree.nodes[n.parent]; } return out; }

function renderTree() {
  treeEl.innerHTML = '';
  const add = (pid, depth) => {
    const list = kids(pid);
    if (pid && !list.length) {
      const e = document.createElement('div'); e.className = 'hint-empty'; e.style.paddingLeft = (30 + depth * 16) + 'px'; e.textContent = 'Пусто';
      treeEl.appendChild(e);
    }
    for (const n of list) {
      const r = document.createElement('div');
      r.className = 'row ' + n.type + (n.open ? ' open' : '') + (cur && cur.id === n.id ? ' active' : '') + (n.id === targetFolder ? ' target' : '');
      r.dataset.id = n.id; r.draggable = true;
      r.style.paddingLeft = (6 + depth * 16) + 'px';
      r.innerHTML = `<span class="car">${n.type === 'folder' ? ic('chev') : ''}</span><span class="ico">${ic(n.type)}</span><span class="nm"></span><button class="sbtn more" title="Ещё">${ic('dots')}</button>`;
      r.querySelector('.nm').textContent = n.name;
      treeEl.appendChild(r);
      if (n.type === 'folder' && n.open) add(n.id, depth + 1);
    }
  };
  add(null, 0);
  if (!Object.keys(tree.nodes).length) {
    const e = document.createElement('div'); e.className = 'hint-empty'; e.style.padding = '8px'; e.textContent = 'Создайте папку или доску кнопками выше';
    treeEl.appendChild(e);
  }
  updateCrumbs();
}
function updateCrumbs() {
  const el = $('#crumbs');
  if (!cur) { el.textContent = ''; return; }
  const p = pathOf(cur.id), last = p.pop();
  el.innerHTML = '';
  if (p.length) el.append(p.join(' / ') + ' / ');
  const b = document.createElement('b'); b.textContent = last; el.append(b);
  document.title = last + ' — VortexBoard';
}
function uniqueName(base, parent, numbered) {
  const names = new Set(kids(parent).map(n => n.name));
  if (!numbered && !names.has(base)) return base;
  for (let i = numbered ? 1 : 2; ; i++) if (!names.has(base + ' ' + i)) return base + ' ' + i;
}
async function createNode(type, parent, rename = true) {
  const n = { id: uid(), type, parent, open: true, created: Date.now(),
    name: type === 'folder' ? uniqueName('Новая папка', parent) : type === 'note' ? uniqueName('Заметка', parent, true) : uniqueName('Доска', parent, true) };
  if (type === 'note') n.text = '';
  tree.nodes[n.id] = n;
  if (parent && tree.nodes[parent]) tree.nodes[parent].open = true;
  if (type === 'folder') targetFolder = n.id;
  saveTree();
  if (type === 'board') { await DB.set('board:' + n.id, { objects: [], view: { x: 0, y: 0, z: 1 } }); await openBoard(n.id); }
  else renderTree();
  if (type === 'note') { if (rename) openNoteEditor(n.id, true); }
  else if (rename) startRename(n.id);
  return n;
}
async function openBoard(id) {
  if (cur && cur.id === id) return;
  if (cur) await saveNow();
  const data = (await DB.get('board:' + id)) || {};
  const objects = data.objects || [], migrated = await hydrate(objects);
  cur = { id, objects, view: data.view || { x: 0, y: 0, z: 1 } };
  if (migrated) scheduleSave();
  undoStack = []; redoStack = []; selectedId = null; drawing = null; drag = null;
  tree.current = id; targetFolder = tree.nodes[id].parent; saveTree();
  stage.classList.remove('noboard');
  $('#zoomVal').textContent = Math.round(cur.view.z * 100) + '%';
  renderTree(); updatePanel(); updateHistBtns(); updateCursor(); baseValid = false; requestRender();
}
function closeBoard() {
  cur = null; selectedId = null; tree.current = null; saveTree();
  stage.classList.add('noboard'); document.title = 'VortexBoard'; updatePanel(); renderTree(); render();
}
function startRename(id) {
  const row = treeEl.querySelector(`.row[data-id="${id}"]`); if (!row) return;
  const n = tree.nodes[id], nm = row.querySelector('.nm');
  const inp = document.createElement('input'); inp.value = n.name;
  nm.replaceWith(inp); inp.focus(); inp.select();
  let done = false;
  const finish = ok => {
    if (done) return; done = true;
    const v = inp.value.trim();
    if (ok && v) { n.name = v; saveTree(); }
    renderTree();
  };
  inp.addEventListener('keydown', e => { e.stopPropagation(); if (e.key === 'Enter') finish(true); if (e.key === 'Escape') finish(false); });
  inp.addEventListener('blur', () => finish(true));
  inp.addEventListener('click', e => e.stopPropagation());
  inp.addEventListener('dblclick', e => e.stopPropagation());
}
async function deleteNode(id) {
  const n = tree.nodes[id];
  const msg = n.type === 'folder' ? `Удалить папку «${n.name}» со всем содержимым?` : n.type === 'note' ? `Удалить заметку «${n.name}»?` : `Удалить доску «${n.name}»?`;
  if (!confirm(msg)) return;
  const ids = [id, ...Object.keys(tree.nodes).filter(x => isDesc(x, id))];
  const closing = cur && ids.includes(cur.id);
  for (const x of ids) { if (tree.nodes[x].type === 'board') DB.del('board:' + x); delete tree.nodes[x]; }
  if (ids.includes(targetFolder)) targetFolder = null;
  saveTree(); gcAssets();
  if (closing) {
    cur = null;
    const next = Object.values(tree.nodes).find(x => x.type === 'board');
    if (next) await openBoard(next.id); else closeBoard();
  } else renderTree();
}

treeEl.addEventListener('click', e => {
  const row = e.target.closest('.row'); if (!row) return;
  const n = tree.nodes[row.dataset.id];
  if (e.target.closest('.more')) { const r = e.target.closest('.more').getBoundingClientRect(); showNodeMenu(n, r.right - 4, r.bottom + 4); return; }
  if (n.type === 'folder') { n.open = !n.open; targetFolder = n.id; saveTree(); renderTree(); }
  else if (n.type === 'note') openNoteEditor(n.id);
  else { openBoard(n.id); closeDrawer(); }
});
treeEl.addEventListener('dblclick', e => { const row = e.target.closest('.row'); if (row && !e.target.closest('.more')) startRename(row.dataset.id); });
treeEl.addEventListener('contextmenu', e => {
  e.preventDefault();
  const row = e.target.closest('.row');
  if (row) showNodeMenu(tree.nodes[row.dataset.id], e.clientX, e.clientY);
  else showMenu(e.clientX, e.clientY, [
    { label: 'Новая папка', icon: 'folderPlus', act: () => createNode('folder', null) },
    { label: 'Новая доска', icon: 'boardPlus', act: () => createNode('board', null) },
    { label: 'Новая заметка', icon: 'notePlus', note: true, act: () => createNode('note', null) }
  ]);
});
function showNodeMenu(n, x, y) {
  const items = [];
  if (n.type === 'folder') {
    items.push({ label: 'Новая доска здесь', icon: 'boardPlus', act: () => createNode('board', n.id) });
    items.push({ label: 'Новая папка здесь', icon: 'folderPlus', act: () => createNode('folder', n.id) });
    items.push({ label: 'Новая заметка здесь', icon: 'notePlus', note: true, act: () => createNode('note', n.id) });
    items.push('-');
  } else if (n.type === 'note') {
    items.push({ label: 'Открыть заметку', icon: 'note', note: true, act: () => openNoteEditor(n.id) });
    items.push('-');
  } else {
    items.push({ label: 'Открыть', icon: 'open', act: () => openBoard(n.id) });
    items.push({ label: 'Сохранить как PNG', icon: 'download', act: () => exportBoard(n.id) });
    items.push({ label: 'Дублировать', icon: 'copy', act: () => duplicateBoard(n.id) });
    items.push('-');
  }
  items.push({ label: 'Переименовать', icon: 'edit', act: () => startRename(n.id) });
  items.push({ label: 'Удалить', icon: 'trash', danger: true, act: () => deleteNode(n.id) });
  showMenu(x, y, items);
}
async function duplicateBoard(id) {
  if (cur && cur.id === id) await saveNow();
  const src = tree.nodes[id], data = (await DB.get('board:' + id)) || { objects: [] };
  const n = { id: uid(), type: 'board', parent: src.parent, open: true, created: Date.now(), name: uniqueName(src.name + ' (копия)', src.parent) };
  tree.nodes[n.id] = n; saveTree();
  await DB.set('board:' + n.id, { objects: data.objects, view: data.view || { x: 0, y: 0, z: 1 } });
  openBoard(n.id);
}

/* tree drag & drop (move items between folders) */
let dragNode = null;
treeEl.addEventListener('dragstart', e => {
  const row = e.target.closest('.row'); if (!row) return;
  dragNode = row.dataset.id; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', dragNode);
});
function dropTarget(e) {
  const row = e.target.closest('.row'); if (!row) return { parent: null, el: treeEl };
  const n = tree.nodes[row.dataset.id];
  if (n.type === 'folder') return { parent: n.id, el: row };
  const pr = n.parent && treeEl.querySelector(`.row[data-id="${n.parent}"]`);
  return { parent: n.parent, el: pr || treeEl };
}
const clearDropMarks = () => { treeEl.classList.remove('droproot'); treeEl.querySelectorAll('.drop').forEach(r => r.classList.remove('drop')); };
treeEl.addEventListener('dragover', e => {
  if (!dragNode) return;
  const t = dropTarget(e);
  clearDropMarks();
  if (t.parent === dragNode || (t.parent && isDesc(t.parent, dragNode))) return;
  e.preventDefault();
  if (t.el === treeEl) treeEl.classList.add('droproot'); else t.el.classList.add('drop');
});
treeEl.addEventListener('dragleave', e => { if (!treeEl.contains(e.relatedTarget)) clearDropMarks(); });
treeEl.addEventListener('drop', e => {
  if (!dragNode) return;
  e.preventDefault(); clearDropMarks();
  const t = dropTarget(e), n = tree.nodes[dragNode];
  if (n && t.parent !== dragNode && !(t.parent && isDesc(t.parent, dragNode))) {
    n.parent = t.parent; if (t.parent) tree.nodes[t.parent].open = true;
    saveTree(); renderTree();
  }
  dragNode = null;
});
treeEl.addEventListener('dragend', () => { dragNode = null; clearDropMarks(); });

/* =========================================================
   Context menu
   ========================================================= */
const menu = $('#menu');
function showMenu(x, y, items) {
  menu.innerHTML = '';
  for (const it of items) {
    if (it === '-') { const s = document.createElement('div'); s.className = 'msep'; menu.appendChild(s); continue; }
    const d = document.createElement('div'); d.className = 'mi' + (it.danger ? ' danger' : '') + (it.note ? ' note' : '');
    d.innerHTML = ic(it.icon) + '<span></span>' + (it.checked ? '<b class="chk">✓</b>' : ''); d.querySelector('span').textContent = it.label;
    d.onclick = () => { hideMenu(); it.act(); };
    menu.appendChild(d);
  }
  menu.classList.add('show');
  const r = menu.getBoundingClientRect();
  menu.style.left = Math.min(x, innerWidth - r.width - 8) + 'px';
  menu.style.top = Math.min(y, innerHeight - r.height - 8) + 'px';
}
function hideMenu() { menu.classList.remove('show'); }
document.addEventListener('pointerdown', e => { if (!menu.contains(e.target)) hideMenu(); });
window.addEventListener('blur', hideMenu);

/* =========================================================
   Notes: tree items, editor, attaching to objects, hover card
   ========================================================= */
const noteOf = o => {
  const n = o && o.noteId && tree.nodes[o.noteId];
  return n && n.type === 'note' ? n : null;
};
const allNotes = () => Object.values(tree.nodes).filter(n => n.type === 'note').sort((a, b) => a.created - b.created);

let editingNote = null;
function openNoteEditor(id, fresh) {
  const n = tree.nodes[id]; if (!n) return;
  hideNoteTip(); hideMenu();
  editingNote = id;
  $('#noteEdTitle').value = n.name; $('#noteEdText').value = n.text || '';
  const path = pathOf(id); path.pop();
  $('#noteEdInfo').textContent = path.length ? path.join(' / ') : 'Корень проекта';
  $('#noteEd').classList.add('show'); syncBack();
  const f = fresh ? $('#noteEdTitle') : $('#noteEdText');
  f.focus(); if (fresh) f.select();
}
function closeNoteEditor() {
  if (!editingNote) return;
  const n = tree.nodes[editingNote];
  if (n && !n.name.trim()) n.name = 'Заметка';
  editingNote = null; $('#noteEd').classList.remove('show');
  saveTree(); renderTree(); requestRender(); syncBack();
}
let noteSaveT;
$('#noteEd').addEventListener('input', () => {
  const n = tree.nodes[editingNote]; if (!n) return;
  n.name = $('#noteEdTitle').value.trim() || n.name; n.text = $('#noteEdText').value;
  clearTimeout(noteSaveT); noteSaveT = setTimeout(() => { saveTree(); renderTree(); }, 300);
});
$('#noteEdIcon').innerHTML = ic('note');
$('#noteEdDone').onclick = closeNoteEditor;
$('#noteEd').addEventListener('pointerdown', e => { if (e.target.id === 'noteEd') closeNoteEditor(); });
$('#noteEd').addEventListener('keydown', e => {
  if (e.key === 'Escape' || (e.key === 'Enter' && (e.ctrlKey || e.metaKey))) { e.preventDefault(); closeNoteEditor(); }
  else if (e.key === 'Enter' && e.target.id === 'noteEdTitle') { e.preventDefault(); $('#noteEdText').focus(); }
});

/* right-click / long-press menu on an object */
function showObjectMenu(o, x, y) {
  select(o.id); hideNoteTip();
  const note = noteOf(o);
  const items = [{ label: 'Редактировать', icon: 'edit', act: () => { setTool('select'); openPanel(o.id); } }];
  if (note) {
    items.push({ label: `Открыть заметку «${note.name}»`, icon: 'note', note: true, act: () => openNoteEditor(note.id) });
    items.push({ label: 'Заменить заметку…', icon: 'notePlus', note: true, act: () => showNotePicker(o, x, y) });
    items.push('-');
    items.push({ label: 'Убрать заметку', icon: 'trash', danger: true, act: () => setObjNote(o.id, null) });
  } else {
    items.push({ label: 'Добавить заметку…', icon: 'notePlus', note: true, act: () => showNotePicker(o, x, y) });
  }
  showMenu(x, y, items);
}
function showNotePicker(o, x, y) {
  const items = [{ label: 'Новая заметка', icon: 'plus', note: true, act: async () => {
    const n = await createNode('note', cur ? tree.nodes[cur.id].parent : null, false);
    setObjNote(o.id, n.id, true); openNoteEditor(n.id, true);
  } }];
  const notes = allNotes();
  if (notes.length) items.push('-');
  for (const n of notes) items.push({ label: n.name, icon: 'note', note: true, checked: n.id === o.noteId, act: () => setObjNote(o.id, n.id) });
  showMenu(x, y, items);
}
function setObjNote(objId, noteId, quiet) {
  const t = cur && cur.objects.find(x => x.id === objId); if (!t) return;
  pushHistory();
  if (noteId) t.noteId = noteId; else delete t.noteId;
  changed();
  if (!quiet) toast(noteId ? `Заметка «${tree.nodes[noteId].name}» прикреплена` : 'Заметка убрана');
}

/* the visual top-right corner of an object, whatever its rotation */
function topRight(o) { return toScreen(corners(o).reduce((a, c) => (c.x - c.y > a.x - a.y ? c : a))); }

function drawNoteBadges() {
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  for (const o of cur.objects) {
    if (o.type !== 'image' || !noteOf(o)) continue;
    const b = topRight(o);
    ctx.beginPath(); ctx.arc(b.x, b.y, 10, 0, Math.PI * 2);
    ctx.fillStyle = '#8b5cf6'; ctx.fill();
    ctx.lineWidth = 2; ctx.strokeStyle = '#fff'; ctx.stroke();
    ctx.beginPath(); ctx.moveTo(b.x - 4, b.y - 2.5); ctx.lineTo(b.x + 4, b.y - 2.5); ctx.moveTo(b.x - 4, b.y + 1); ctx.lineTo(b.x + 1.5, b.y + 1);
    ctx.lineWidth = 1.6; ctx.lineCap = 'round'; ctx.stroke();
  }
}

const tipEl = $('#noteTip');
let tipKey = null;
function hideNoteTip() { tipKey = null; tipEl.classList.remove('show'); }
function updateNoteTip(p) {
  // never while the object is being moved, resized, rotated or edited
  if (!cur || !p || drag || drawing || editingNote || menu.classList.contains('show')) return hideNoteTip();
  let o = hitImage(p);
  if (!noteOf(o)) o = [...cur.objects].reverse().find(x => x.type === 'image' && noteOf(x) && Math.hypot(topRight(x).x - p.sx, topRight(x).y - p.sy) < 12);
  const note = noteOf(o);
  if (!note || (panelOpen && selectedId === o.id)) return hideNoteTip();
  const key = o.id + '|' + note.name + '|' + note.text;
  if (tipKey !== key) {
    tipKey = key;
    tipEl.innerHTML = `<div class="t">${ic('note')}<span></span></div><div class="b"></div>`;
    tipEl.querySelector('.t span').textContent = note.name;
    const body = tipEl.querySelector('.b');
    body.textContent = note.text && note.text.trim() ? note.text : 'Пустая заметка';
    body.classList.toggle('empty', !(note.text && note.text.trim()));
  }
  const b = topRight(o), w = tipEl.offsetWidth, h = tipEl.offsetHeight;
  let x = b.x + 16, y = b.y - 12;
  if (x + w > W - 8) x = b.x - 16 - w;
  tipEl.style.left = clamp(x, 8, Math.max(8, W - w - 8)) + 'px';
  tipEl.style.top = clamp(y, 8, Math.max(8, H - h - 8)) + 'px';
  tipEl.classList.add('show');
}

/* =========================================================
   Keyboard
   ========================================================= */
document.addEventListener('keydown', e => {
  if (/input|textarea|select/i.test(e.target.tagName) && e.target.type !== 'range' && e.target.type !== 'color') return;
  if (e.key === 'Escape') { hideMenu(); if (selectedId) select(null); return; }
  if (!cur) return;
  const mod = e.ctrlKey || e.metaKey, k = e.key.toLowerCase(), code = e.code;
  if (mod && (code === 'KeyZ') && !e.shiftKey) { e.preventDefault(); undo(); return; }
  if (mod && ((code === 'KeyZ' && e.shiftKey) || code === 'KeyY')) { e.preventDefault(); redo(); return; }
  if (mod && code === 'KeyS') { e.preventDefault(); exportBoard(cur.id); return; }
  if (mod && code === 'KeyD') { e.preventDefault(); imageAction('dup'); return; }
  if (mod) return;
  if ((k === 'delete' || k === 'backspace') && selectedId) { e.preventDefault(); imageAction('del'); return; }
  if (code === 'Space') { e.preventDefault(); if (!spaceDown) { spaceDown = true; updateCursor(); requestRender(); } return; }
  if (k === '[' || k === ']') {
    if (st.sizes[st.tool] != null) { st.sizes[st.tool] = clamp(st.sizes[st.tool] + (k === ']' ? 2 : -2), 1, 120); syncControls(); saveTools(); requestRender(); }
    return;
  }
  const t = TOOLS.find(t => t !== '-' && ('Key' + t.key) === code);
  if (t) setTool(t.id);
});
document.addEventListener('keyup', e => { if (e.code === 'Space') { spaceDown = false; updateCursor(); requestRender(); } });

/* =========================================================
   Phone drawer, Telegram Mini App, PNG delivery
   ========================================================= */
const isPhone = () => matchMedia('(max-width: 720px)').matches;
function openDrawer() { $('#app').classList.add('drawer'); syncBack(); }
function closeDrawer() { if ($('#app').classList.contains('drawer')) { $('#app').classList.remove('drawer'); syncBack(); } }

const tg = window.Telegram && Telegram.WebApp && Telegram.WebApp.initData ? Telegram.WebApp : null;
const tgCall = fn => { try { fn(); } catch (e) {} }; // older Telegram clients lack some methods
if (tg) {
  document.documentElement.classList.add('tg');
  tgCall(() => tg.ready()); tgCall(() => tg.expand());
  tgCall(() => tg.disableVerticalSwipes()); // otherwise drawing downwards swipes the app closed
  tgCall(() => tg.setHeaderColor('#fbfbf9')); tgCall(() => tg.setBackgroundColor('#f3f3f0')); tgCall(() => tg.setBottomBarColor('#f3f3f0'));
  const fitHeight = () => document.documentElement.style.setProperty('--app-h', (tg.viewportStableHeight || innerHeight) + 'px');
  fitHeight(); tg.onEvent('viewportChanged', fitHeight);
  tgCall(() => tg.BackButton.onClick(goBack));
}
// Telegram's back button closes whatever is on top
function goBack() {
  if (editingNote) closeNoteEditor();
  else if (menu.classList.contains('show')) hideMenu();
  else if ($('#pngView').classList.contains('show')) closePngView();
  else if (panelOpen) { panelOpen = false; updatePanel(); }
  else closeDrawer();
  syncBack();
}
function syncBack() {
  if (!tg) return;
  const open = editingNote || panelOpen || $('#app').classList.contains('drawer') || $('#pngView').classList.contains('show');
  tgCall(() => open ? tg.BackButton.show() : tg.BackButton.hide());
}

let pngFile = null, pngURL = null;
function showPngView(file) {
  pngFile = file; if (pngURL) URL.revokeObjectURL(pngURL);
  pngURL = URL.createObjectURL(file); $('#pngImg').src = pngURL;
  $('#pngShare').style.display = navigator.canShare && navigator.canShare({ files: [file] }) ? '' : 'none';
  $('#pngView').classList.add('show'); syncBack();
}
function closePngView() { $('#pngView').classList.remove('show'); syncBack(); }
$('#pngClose').onclick = closePngView;
$('#pngView').addEventListener('click', e => { if (e.target.id === 'pngView') closePngView(); });
$('#pngShare').onclick = () => { if (pngFile) navigator.share({ files: [pngFile], title: pngFile.name }).catch(() => {}); };

// Desktop: download. Phones: system share sheet. Telegram (no downloads in its webview): preview to save or share.
async function deliverPNG(blob, name) {
  const file = new File([blob], name, { type: 'image/png' });
  if (tg || touchUI()) {
    if (navigator.canShare && navigator.canShare({ files: [file] })) {
      try { await navigator.share({ files: [file], title: name }); return 'shared'; }
      catch (e) { if (e.name === 'AbortError') return 'cancelled'; } // NotAllowedError etc: fall through
    }
    if (tg) { showPngView(file); return 'view'; }
  }
  download(blob, name); return 'downloaded';
}

